        <item name="colorPrimary">@color/primary_brand</item>
        <item name="colorOnPrimary">@color/on_primary_brand</item>
        <item name="colorSecondary">@color/ui_accent</item>
        <item name="colorOnSecondary">@color/ui_surface</item>
        <item name="colorSurface">@color/ui_surface</item>
        <item name="colorOnSurface">@color/ui_text</item>
        <item name="colorSurfaceVariant">@color/ui_tonal</item>
        <item name="colorOnSurfaceVariant">@color/ui_muted</item>
